{
  "version": 2,
  "buildCommand": "cd crm-app && npm run build",
  "outputDirectory": "crm-app/dist",
  "crons": [
    {
      "path": "/api/cron-batch",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron-sla",
      "schedule": "*/5 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
