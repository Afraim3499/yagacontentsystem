{
  "version": 2,
  "buildCommand": "cd crm-app && npm run build",
  "outputDirectory": "crm-app/dist",
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron-batch",
      "schedule": "*/1 * * * *"
    },
    {
      "path": "/api/cron-sla",
      "schedule": "*/5 * * * *"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
